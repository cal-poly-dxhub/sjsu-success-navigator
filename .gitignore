# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
# Astro's local build cache (regenerated by every build)
.astro/
build/
out/
cdk.out/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Generated from data/ before every build: a committed copy would be a second source of truth.
frontend/src/lib/generated/

# Hand-written to point `astro dev` at a deployed API, at the bucket key the stack stamps.
frontend/public/config.json

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# draw.io desktop writes a .$<name>.bkp scratch file beside the diagram it has open
.$*.bkp

# Test / coverage
coverage/
.pytest_cache/
.nyc_output/

# Claude
.claude

# Eval run artifacts: local records, not source
eval/results/
eval/judgments/
