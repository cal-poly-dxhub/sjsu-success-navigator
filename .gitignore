# Temporary placeholder .gitignore - replace once the stack is settled

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
# Astro's local build cache (regenerated by every build)
.astro/
build/
out/
cdk.out/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Local dev runtime config, hand-written to point `astro dev` at a deployed API. It is
# the same bucket key the stack stamps at deploy time, so a committed copy is a second
# source of truth for the one file that says where the API is - and the wrong one, since
# it names whichever stack the developer happened to be testing against.
frontend/public/config.json

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.pytest_cache/
.nyc_output/
