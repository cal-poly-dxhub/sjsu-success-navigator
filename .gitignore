# Temporary placeholder .gitignore - replace once the stack is settled

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
# Astro's local build cache (regenerated by every build)
.astro/
build/
out/
cdk.out/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# The TypeScript view of repo-root data/, written by frontend/scripts/generate-campus-data.mjs
# before every `npm run build` and `npm run dev`. Ignored so it CANNOT be committed: a
# committed copy is a second source of truth for facts that already have one, and the kind that
# goes stale silently because it looks like ordinary source. Regeneration belongs to the build.
frontend/src/lib/generated/

# Local dev runtime config, hand-written to point `astro dev` at a deployed API. It is
# the same bucket key the stack stamps at deploy time, so a committed copy is a second
# source of truth for the one file that says where the API is - and the wrong one, since
# it names whichever stack the developer happened to be testing against.
frontend/public/config.json

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# draw.io desktop writes a .$<name>.bkp scratch file beside the diagram it has open
.$*.bkp

# Test / coverage
coverage/
.pytest_cache/
.nyc_output/

# Claude
.claude

# Eval run artifacts (transcripts, rendered pages, judgments) - local records, not source
eval/results/
eval/judgments/
